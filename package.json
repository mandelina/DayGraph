{
  "name": "daygraph",
  "private": true,
  "version": "0.1.0",
  "description": "DayGraph monorepo (Electron + React + Collector)",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "install:all": "pnpm install",
    "dev": "concurrently -k -n collector,app -c blue,green \"pnpm collector\" \"pnpm -C apps/electron dev\"",
    "build": "pnpm -C apps/renderer build && pnpm -C apps/electron build",
    "preview": "pnpm -C apps/electron preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build",
    "format": "pnpm -r format",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "collector": "pnpm -C packages/collector start"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "typescript": "~5.4.5",
    "vitest": "^1.6.1"
  }
}
