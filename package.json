{
  "name": "daygraph",
  "private": true,
  "version": "0.1.0",
  "description": "DayGraph monorepo (Electron + React + Collector)",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "install:all": "pnpm install",
    "dev": "pnpm prepare:collector-assets && pnpm -C apps/electron dev",
    "build": "pnpm -C apps/renderer build && pnpm prepare:collector-assets && pnpm -C apps/electron build",
    "prepare:collector-assets": "node scripts/prepare-collector-assets.mjs",
    "preview": "pnpm -C apps/electron preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "node scripts/electron-smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build",
    "package:mac": "pnpm build && electron-builder --mac dir --config electron-builder.yml",
    "package:mac:dmg": "pnpm build && electron-builder --mac dmg --config electron-builder.yml",
    "format": "pnpm -r format",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "collector": "pnpm -C packages/collector start"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.67.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
