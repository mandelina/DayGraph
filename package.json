{
  "name": "daygraph",
  "private": true,
  "version": "0.1.0",
  "description": "DayGraph monorepo (Electron + React + Collector)",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "install:all": "pnpm install",
    "dev": "concurrently -k -n collector,app -c blue,green \"pnpm collector\" \"pnpm -C apps/electron dev\"",
    "build": "pnpm -C apps/renderer build && pnpm -C apps/electron build",
    "preview": "pnpm -C apps/electron preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build",
    "format": "pnpm -r format",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "collector": "pnpm -C packages/collector start"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
