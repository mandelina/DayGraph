{
  "name": "@daygraph/collector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "build:helper:darwin": "sh ./scripts/build-macos-helper.sh",
    "verify:helper:darwin": "sh ./scripts/check-macos-helper.sh",
    "build:helper:darwin-display": "sh ./scripts/build-macos-display-helper.sh",
    "verify:helper:darwin-display": "sh ./scripts/check-macos-display-helper.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'",
    "format": "prettier --write . || true"
  },
  "dependencies": {
    "@daygraph/db": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "get-windows": "^9.1.0",
    "uiohook-napi": "^1.5.5",
    "node-window-manager": "^2.2.4"
  }
}
