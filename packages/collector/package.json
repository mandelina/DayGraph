{
  "name": "@daygraph/collector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "build:helper:darwin": "sh ./scripts/build-macos-helper.sh",
    "verify:helper:darwin": "sh ./scripts/check-macos-helper.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'",
    "format": "prettier --write . || true"
  },
  "dependencies": {
    "@daygraph/db": "workspace:*",
    "better-sqlite3": "^9.6.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "~5.4.5"
  },
  "optionalDependencies": {
    "active-win": "^8.1.0",
    "node-window-manager": "^2.2.5"
  }
}
