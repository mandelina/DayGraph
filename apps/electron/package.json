{
  "name": "daygraph-electron",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'",
    "restart": "pnpm run stop && pnpm run dev",
    "stop": "pkill -f electron-vite || taskkill /IM electron-vite.exe /F || true"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "get-windows": "^9.3.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-window-manager": "^2.2.4",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3"
  }
}
